[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    .venv,
    venv,
    .pytest_cache,
    .mypy_cache
extend-ignore =
    # E203: whitespace before ':'  (conflicts with Black)
    E203,
    # W503: line break before binary operator (conflicts with Black)
    W503
per-file-ignores =
    # Imported but unused in __init__.py files is normal
    __init__.py:F401
