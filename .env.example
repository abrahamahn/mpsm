# MPSM Custom Paths Configuration
# Add your custom plugin directories here (one per line)
# These paths will be scanned in addition to the default paths in config.yaml

# ============================================================
# CUSTOM VST2 PATHS (add as many as you need)
# ============================================================
CUSTOM_VST2_PATH_1=C:\Production\Library\VST2
# CUSTOM_VST2_PATH_2=D:\Audio\VST2
# CUSTOM_VST2_PATH_3=E:\Plugins\VST2

# ============================================================
# CUSTOM VST3 PATHS
# ============================================================
# CUSTOM_VST3_PATH_1=C:\Production\Library\VST3
# CUSTOM_VST3_PATH_2=D:\Audio\VST3

# ============================================================
# CUSTOM AAX PATHS
# ============================================================
# CUSTOM_AAX_PATH_1=C:\Production\Library\AAX

# ============================================================
# CUSTOM CLAP PATHS
# ============================================================
# CUSTOM_CLAP_PATH_1=C:\Production\Library\CLAP

# ============================================================
# CUSTOM GENERAL PLUGIN PATHS (scans all types)
# ============================================================
# CUSTOM_PLUGIN_PATH_1=C:\MyPlugins
# CUSTOM_PLUGIN_PATH_2=D:\Audio\AllPlugins

# ============================================================
# USAGE INSTRUCTIONS
# ============================================================
# 1. Uncomment lines (remove the #) to enable a path
# 2. Change the path to your actual directory
# 3. Add more paths by copying lines and incrementing the number
# 4. Run: python mpsm.py scan
#
# Examples:
#   CUSTOM_VST2_PATH_1=C:\Production\Library\VST2
#   CUSTOM_VST2_PATH_2=D:\More Plugins\VST2
#   CUSTOM_VST3_PATH_1=C:\Production\Library\VST3
